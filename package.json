{
  "name": "ceygom-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc -p api/tsconfig.json --noEmit && tsc -p packages/shared/tsconfig.json --noEmit",
    "test": "vitest run",
    "api:build": "npm --prefix api run build",
    "swa": "swa start http://localhost:4321 --api-location api --run \"npm run dev\""
  },
  "dependencies": {
    "@astrojs/react": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@azure/static-web-apps-cli": "^2.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
