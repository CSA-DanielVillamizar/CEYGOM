{
  "routes": [
    { "route": "/api/*", "allowedRoles": ["anonymous"] },
    { "route": "/index.html", "redirect": "/", "statusCode": 301 },
    { "route": "/empresa.html", "redirect": "/empresa/", "statusCode": 301 },
    { "route": "/productos.html", "redirect": "/productos/", "statusCode": 301 },
    { "route": "/desarrollos.html", "redirect": "/productos/#a-medida", "statusCode": 301 },
    { "route": "/ubicacion.html", "redirect": "/contacto/", "statusCode": 301 },
    { "route": "/contacto.html", "redirect": "/contacto/", "statusCode": 301 },
    { "route": "/_astro/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/fichas/*", "headers": { "Cache-Control": "public, max-age=86400" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'"
  },
  "platform": {
    "apiRuntime": "node:22"
  }
}
