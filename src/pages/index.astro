---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { CATEGORIES, PRODUCTS } from "@shared/catalog";
import { PRODUCT_DETAILS } from "@shared/catalog-details";
import { CATEGORY_IMAGES } from "../data/categoryImages";
import { LEGAL } from "../data/legal";
import { productImage } from "../lib/productImages";
import { LOGO } from "../data/brand";

// Every figure shown on this page is computed from the catalog data, never typed by hand.
const withPage = PRODUCTS.filter((p) => PRODUCT_DETAILS[p.slug]);
const totals = {
  products: withPage.length,
  references: withPage.reduce((n, p) => n + PRODUCT_DETAILS[p.slug]!.references.length, 0),
  sheets: withPage.filter((p) => PRODUCT_DETAILS[p.slug]!.ficha).length,
};
const perCategory = Object.fromEntries(
  CATEGORIES.map((c) => {
    const items = withPage.filter((p) => p.category === c.id);
    return [c.id, { products: items.length, references: items.reduce((n, p) => n + PRODUCT_DETAILS[p.slug]!.references.length, 0) }];
  }),
);
const plural = (n: number, one: string, many: string) => `${n.toLocaleString("es-CO")} ${n === 1 ? one : many}`;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://electrometalicasceygom.com";
const description = "Fabricamos gabinetes eléctricos, racks de comunicaciones, bandejas portacables, canaletas y estructuras a medida. Solicite su cotización en línea.";
const logoUrl = new URL(LOGO.pngPath, siteUrl).toString();

// Local business data for search engines: only facts already published on the site.
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": new URL("/#empresa", siteUrl).toString(),
  name: LEGAL.tradeName,
  ...(LEGAL.legalName ? { legalName: LEGAL.legalName } : {}),
  ...(LEGAL.nit ? { taxID: LEGAL.nit } : {}),
  url: new URL("/", siteUrl).toString(),
  description,
  logo: logoUrl,
  image: logoUrl,
  telephone: "+57 604 444 6733",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Calle 28 nro 57-13, Unidad Industrial de Belén",
    addressLocality: "Medellín",
    addressRegion: "Antioquia",
    addressCountry: "CO",
  },
  hasMap: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("Calle 28 #57-13, Unidad Industrial de Belén, Medellín")}`,
};

// Four photos of the same size on a flat grey stage (2x2).
const hero = ["rack-piso-cerrado", "gabinete-equipos-medida", "canaleta-metalica2", "gabinete-de-gas"] as const;
---

<Layout title="Gabinetes, racks y bandejas portacables en Medellín | Electro Metálicas Ceygom" description={description} jsonLd={[localBusiness]}>
  <section class="bg-steel-900 text-white">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:py-16 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <h1 class="text-3xl leading-tight sm:text-5xl">Gabinetes, racks y estructuras metálicas para redes eléctricas y de comunicación</h1>
        <p class="mt-4 max-w-xl text-lg text-white/80">
          Fabricamos en Medellín productos estándar y a medida. Nuestro equipo de ingeniería diseña en 3D y usted aprueba antes de fabricar.
        </p>
        <p class="font-display mt-5 max-w-xl border-l-4 border-brand-400 pl-4 text-xl text-white sm:text-2xl">Lo ve en 3D antes de que lo fabriquemos.</p>

        <form action="/productos/" method="get" role="search" class="mt-6 flex max-w-xl gap-2">
          <label for="hero-q" class="sr-only">Buscar un producto o una referencia</label>
          <input id="hero-q" name="q" type="search" autocomplete="off" placeholder="Producto o código" class="h-11 min-w-0 flex-1 rounded-sm border border-white/20 bg-white px-4 text-base text-steel-900 placeholder:text-steel-600" />
          <button type="submit" class="h-11 rounded-sm bg-white px-5 font-semibold text-steel-900 hover:bg-steel-200">Buscar</button>
        </form>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/cotizador/" class="chaflan inline-flex h-[52px] items-center bg-brand-600 px-6 font-semibold hover:bg-brand-700">Solicitar cotización</a>
          <a href="/productos/" class="inline-flex h-[52px] items-center rounded-sm border border-white/40 px-6 font-semibold hover:bg-white/10">Ver productos</a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3" aria-hidden="true">
        {hero.map((file) => (
          <div class="foto-tarjeta aspect-square overflow-hidden rounded-sm">
            <Image src={productImage(file)} alt="" width={360} class="h-full w-full object-contain" loading="eager" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-steel-200 bg-white">
    <dl class="mx-auto grid max-w-6xl grid-cols-3 gap-4 px-4 py-6 text-center">
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-wider text-steel-600 sm:text-xs">Referencias</dt>
        <dd class="font-display text-2xl text-brand-600 sm:text-4xl">{totals.references.toLocaleString("es-CO")}</dd>
      </div>
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-wider text-steel-600 sm:text-xs">Productos</dt>
        <dd class="font-display text-2xl text-brand-600 sm:text-4xl">{totals.products}</dd>
      </div>
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-wider text-steel-600 sm:text-xs">Fichas técnicas</dt>
        <dd class="font-display text-2xl text-brand-600 sm:text-4xl">{totals.sheets}</dd>
      </div>
    </dl>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="text-2xl">Líneas de producto</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {CATEGORIES.map((c) => {
        const image = CATEGORY_IMAGES[c.id];
        const n = perCategory[c.id]!;
        return (
          <li>
            <a href={`/productos/#${c.id}`} class="chaflan-borde block h-full">
            <span class="flex h-full flex-col overflow-hidden">
              {image && (
                <span class="foto-tarjeta relative block">
                  <Image src={productImage(image.file)} alt="" width={420} class="h-40 w-full object-contain" loading="lazy" />
                  {image.illustrative && <span class="absolute left-2 top-2 font-mono text-[11px] text-steel-600">Imagen ilustrativa</span>}
                </span>
              )}
              <span class="p-5">
                <span class="font-display block text-base font-bold">{c.label}</span>
                <span class="mt-1 block text-sm text-steel-600">
                  {c.id === "a-medida" ? "Según sus planos o necesidades" : `${plural(n.products, "producto", "productos")} · ${plural(n.references, "referencia", "referencias")}`}
                </span>
              </span>
            </span>
          </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="perforado text-white">
    <div class="mx-auto grid max-w-6xl items-center gap-6 px-4 py-12 md:grid-cols-[1fr_auto]">
      <div>
        <h2 class="text-2xl sm:text-3xl">Fabricación a medida</h2>
        <p class="mt-3 max-w-2xl text-white/80">
          Cajas, gabinetes y estructuras según sus planos o necesidades. Envíenos su plano: nuestro equipo de ingeniería lo modela en 3D, usted lo aprueba y recién entonces fabricamos.
        </p>
      </div>
      <a href="/cotizador/?producto=fabricacion-a-medida" class="chaflan inline-flex h-[52px] items-center justify-self-start bg-brand-600 px-6 font-semibold hover:bg-brand-700 md:justify-self-end">Enviar mi plano</a>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3">
      <div>
        <h2 class="text-base">Ingeniería y modelado 3D</h2>
        <p class="mt-2 text-sm text-steel-600">Visualizamos cada pieza, terminado y ensamblaje antes de producir, para reducir costos y tiempos.</p>
      </div>
      <div>
        <h2 class="text-base">Fabricación estándar y a medida</h2>
        <p class="mt-2 text-sm text-steel-600">Cajas y gabinetes modificables según las necesidades específicas de cada cliente.</p>
      </div>
      <div>
        <h2 class="text-base">Fichas técnicas</h2>
        <p class="mt-2 text-sm text-steel-600">Documentación técnica de bandejas, canaletas, racks, celdas y soportes.</p>
      </div>
    </div>
  </section>
</Layout>
