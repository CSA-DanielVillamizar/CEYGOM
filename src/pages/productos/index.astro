---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { CATEGORIES, PRODUCTS } from "@shared/catalog";
import { PRODUCT_DETAILS } from "@shared/catalog-details";
import { productImage } from "../../lib/productImages";

const categories = CATEGORIES.filter((c) => c.id !== "a-medida");
---

<Layout
  title="Productos"
  description="Bandejas portacables, canaletas, racks y comunicaciones, línea eléctrica, soportes y fabricación a medida. Referencias, fichas técnicas y cotización en línea."
>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="text-3xl font-bold">Productos</h1>
    <p class="mt-2 max-w-2xl text-steel-600">Consulta las referencias y la ficha técnica de cada producto y solicita tu cotización. Si no encuentras lo que buscas, lo fabricamos a medida.</p>

    <nav aria-label="Categorías" class="mt-6 flex flex-wrap gap-2 text-sm">
      {CATEGORIES.map((c) => <a href={`#${c.id}`} class="rounded-full border border-steel-200 bg-white px-3 py-1 hover:border-brand-600">{c.label}</a>)}
    </nav>

    {categories.map((c) => (
      <section id={c.id} class="mt-12 scroll-mt-6">
        <h2 class="text-2xl font-bold">{c.label}</h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {PRODUCTS.filter((p) => p.category === c.id).map((p) => {
            const d = PRODUCT_DETAILS[p.slug];
            const image = d?.images[0];
            return (
              <li class="flex flex-col overflow-hidden rounded-lg border border-steel-200 bg-white">
                <a href={`/productos/${p.category}/${p.slug}/`} class="block bg-steel-50">
                  {image && (
                    <Image src={productImage(image.file)} alt={image.illustrative ? `${p.name} (imagen ilustrativa)` : p.name} width={320} class="mx-auto h-44 w-full object-contain" loading="lazy" />
                  )}
                  {image?.illustrative && <span class="block pb-1 text-center text-[11px] text-steel-600">Imagen ilustrativa</span>}
                </a>
                <div class="flex flex-1 flex-col justify-between p-4">
                  <div>
                    <h3 class="font-semibold"><a href={`/productos/${p.category}/${p.slug}/`} class="hover:text-brand-700">{p.name}</a></h3>
                    <p class="mt-1 text-xs text-steel-600">
                      {d && d.references.length > 0 ? `${d.references.length} referencia${d.references.length === 1 ? "" : "s"}` : "Consultar referencias"}
                      {d?.ficha ? " · Ficha técnica PDF" : ""}
                    </p>
                  </div>
                  <a href={`/cotizador/?producto=${p.slug}`} class="mt-4 text-sm font-semibold text-brand-700 hover:underline">Cotizar este producto →</a>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}

    <section id="a-medida" class="mt-12 scroll-mt-6 rounded-lg border border-steel-200 bg-white p-6">
      <h2 class="text-2xl font-bold">Fabricación a medida</h2>
      <p class="mt-2 max-w-2xl text-steel-600">Gabinetes, racks y estructuras metálicas según tus planos o necesidades. Cuéntanos qué necesitas y un asesor te responde con una cotización formal.</p>
      <a href="/cotizador/?producto=fabricacion-a-medida" class="mt-4 inline-block rounded bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700">Solicitar cotización a medida</a>
    </section>
  </div>
</Layout>
