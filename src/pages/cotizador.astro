---
import Layout from "../layouts/Layout.astro";
import QuoteWizard from "../components/QuoteWizard";
---

<Layout
  title="Cotizador en línea"
  description="Describe lo que necesitas en cuatro pasos y recibe atención de un asesor de Electro Metálicas Ceygom por WhatsApp."
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-bold">Cotizador en línea</h1>
    <p class="mt-2 text-steel-600">Cuéntanos qué necesitas. No calculamos precios automáticamente: un asesor te responde con una cotización formal.</p>
    <div class="mt-6">
      <QuoteWizard client:load />
    </div>
  </div>
</Layout>
