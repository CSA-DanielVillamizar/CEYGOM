---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada" description="La página que buscas no existe o cambió de dirección.">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center">
    <h1 class="text-4xl font-bold">Página no encontrada</h1>
    <p class="mt-3 text-steel-600">Puede que la dirección haya cambiado. Prueba con alguna de estas opciones:</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/productos/" class="rounded bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700">Ver productos</a>
      <a href="/cotizador/" class="rounded border border-steel-200 bg-white px-6 py-3 font-semibold hover:border-brand-600">Solicitar cotización</a>
    </div>
  </div>
</Layout>
