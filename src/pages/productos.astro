---
import Layout from "../layouts/Layout.astro";
import { CATEGORIES, PRODUCTS } from "@shared/catalog";
---

<Layout
  title="Productos"
  description="Bandejas portacables, canaletas, racks y comunicaciones, línea eléctrica, soportes y fabricación a medida. Cotiza cada referencia en línea."
>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="text-3xl font-bold">Productos</h1>
    <p class="mt-2 max-w-2xl text-steel-600">Elige una referencia y solicita tu cotización. Si no encuentras lo que buscas, lo fabricamos a medida.</p>

    <nav aria-label="Categorías" class="mt-6 flex flex-wrap gap-2 text-sm">
      {CATEGORIES.map((c) => <a href={`#${c.id}`} class="rounded-full border border-steel-200 bg-white px-3 py-1 hover:border-brand-600">{c.label}</a>)}
    </nav>

    {CATEGORIES.map((c) => (
      <section id={c.id} class="mt-12 scroll-mt-6">
        <h2 class="text-2xl font-bold">{c.label}</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {PRODUCTS.filter((p) => p.category === c.id).map((p) => (
            <li class="flex flex-col justify-between rounded-lg border border-steel-200 bg-white p-4">
              <h3 class="font-semibold">{p.name}</h3>
              {/* TODO(negocio): add photo, short description and data-sheet PDF per product. */}
              <a href={`/cotizador/?producto=${p.slug}`} class="mt-4 text-sm font-semibold text-brand-700 hover:underline">
                Cotizar este producto →
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>
