---
import "../styles/global.css";
import { getImage } from "astro:assets";
import { buildWhatsappChatUrl } from "@shared/whatsapp";
import { LEGAL, nitDisplay } from "../data/legal";
import logoNegativo from "../assets/brand/ceygom-horizontal-negativo.svg";
import ogDefault from "../assets/brand/og-default.jpg";

interface Props {
  title: string;
  description: string;
  /** Absolute URL of the image used when the page is shared. */
  image?: string;
  /** schema.org objects rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
  /** For personal pages (the quote list) that should not appear in search results. */
  noindex?: boolean;
}

const { title, description, image, jsonLd = [], noindex = false } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://electrometalicasceygom.com";
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const fullTitle = title.includes("Ceygom") ? title : `${title} | Electro Metálicas Ceygom`;
// Pages without their own picture share the brand image (1200x630) when the link is shared.
const shareImage = image ?? new URL((await getImage({ src: ogDefault, width: 1200, height: 630 })).src, siteUrl).toString();

// Set PUBLIC_WHATSAPP_NUMBER (digits only, international format). Without it the floating button points to the quote form.
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER as string | undefined;
const floatingHref = whatsappNumber ? buildWhatsappChatUrl(whatsappNumber) : "/cotizador/";

const nav = [
  { href: "/", label: "Inicio" },
  { href: "/productos/", label: "Productos" },
  { href: "/empresa/", label: "Empresa" },
  { href: "/contacto/", label: "Contacto" },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <meta name="theme-color" content="#16191d" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen font-sans antialiased flex flex-col">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2">Saltar al contenido</a>

    <header class="bg-steel-900 text-white print:hidden">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
        <a href="/" class="shrink-0" aria-label="CEYGOM Electro Metálicas, inicio">
          <img src={logoNegativo.src} width={logoNegativo.width} height={logoNegativo.height} alt="CEYGOM Electro Metálicas" class="h-9 w-auto sm:h-10" />
        </a>
        <nav aria-label="Principal" class="hidden md:block">
          <ul class="flex flex-wrap items-center gap-1 text-sm">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={path === item.href ? "page" : undefined}
                  class:list={["rounded-sm px-3 py-2 hover:bg-white/10", path === item.href && "bg-white/15 font-semibold"]}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <a href="/cotizacion/" aria-current={path === "/cotizacion/" ? "page" : undefined} class:list={["rounded-sm px-3 py-2 hover:bg-white/10", path === "/cotizacion/" && "bg-white/15 font-semibold"]}>
                Mi cotización<span data-cart-count hidden class="ml-1 rounded-full bg-brand-600 px-2 py-0.5 text-xs font-semibold"></span>
              </a>
            </li>
            <li>
              <a href="/cotizador/" class="chaflan ml-1 inline-block bg-brand-600 px-5 py-2.5 font-semibold hover:bg-brand-700">Cotizar</a>
            </li>
          </ul>
        </nav>
        <!-- On a phone: one line (logo and menu). The three main actions live in the bottom bar. -->
        <details class="relative md:hidden">
          <summary class="flex h-11 cursor-pointer list-none items-center gap-2 rounded-sm px-3 text-sm font-semibold hover:bg-white/10 [&::-webkit-details-marker]:hidden">
            <svg aria-hidden="true" width="18" height="14" viewBox="0 0 18 14" fill="currentColor"><rect width="18" height="2"/><rect y="6" width="18" height="2"/><rect y="12" width="18" height="2"/></svg>
            Menú<span data-cart-count hidden class="rounded-full bg-brand-600 px-2 py-0.5 text-xs font-semibold"></span>
          </summary>
          <nav aria-label="Menú principal" class="absolute right-0 top-12 z-50 w-60 rounded-sm border border-white/10 bg-steel-800 p-2 shadow-lg">
            <ul class="text-sm">
              {nav.map((item) => (
                <li><a href={item.href} aria-current={path === item.href ? "page" : undefined} class:list={["block rounded-sm px-3 py-3", path === item.href ? "bg-white/15 font-semibold" : "hover:bg-white/10"]}>{item.label}</a></li>
              ))}
              <li><a href="/cotizacion/" aria-current={path === "/cotizacion/" ? "page" : undefined} class:list={["block rounded-sm px-3 py-3", path === "/cotizacion/" ? "bg-white/15 font-semibold" : "hover:bg-white/10"]}>Mi cotización</a></li>
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <footer class="bg-steel-900 text-sm text-white/80 print:hidden">
      <!-- Bottom padding keeps the last lines above the floating WhatsApp button and the phone action bar. -->
      <div class="mx-auto grid max-w-6xl gap-4 px-4 pt-8 pb-28 sm:grid-cols-2 md:pb-24">
        <div>
          <img src={logoNegativo.src} width={logoNegativo.width} height={logoNegativo.height} alt="CEYGOM Electro Metálicas" class="h-10 w-auto" loading="lazy" />
          <p class="mt-3 font-semibold text-white">{LEGAL.legalName ?? LEGAL.tradeName}</p>
          {LEGAL.nit && <p>NIT <span class="font-mono">{nitDisplay(LEGAL.nit)}</span></p>}
          <p>Calle 28 nro 57-13, Unidad Industrial de Belén, Medellín</p>
          <p>Tel.: <a class="font-mono underline" href={LEGAL.phoneHref}>{LEGAL.phoneLabel}</a></p>
        </div>
        <div class="sm:text-right">
          <p>© {new Date().getFullYear()} Electro Metálicas Ceygom. Todos los derechos reservados.</p>
          <p class="mt-1"><a class="underline" href="/privacidad/">Política de tratamiento de datos personales</a></p>
        </div>
      </div>
    </footer>

    <a
      href={floatingHref}
      target={whatsappNumber ? "_blank" : undefined}
      rel={whatsappNumber ? "noopener noreferrer" : undefined}
      class="fixed bottom-4 right-4 z-40 hidden rounded-full bg-green-600 px-5 py-3 text-sm font-bold text-white shadow-lg hover:bg-green-700 md:block print:hidden"
      aria-label={whatsappNumber ? "Escribir por WhatsApp" : "Solicitar cotización"}
    >
      {whatsappNumber ? "WhatsApp" : "Cotizar"}
    </a>

    <!-- Phone only: the three actions that matter, always within reach. -->
    <div role="group" aria-label="Acciones rápidas" class={`fixed inset-x-0 bottom-0 z-40 grid ${whatsappNumber ? "grid-cols-3" : "grid-cols-2"} border-t border-white/10 bg-steel-900 text-sm font-semibold text-white md:hidden print:hidden`}>
      <a href="/cotizador/" class="flex h-14 items-center justify-center bg-brand-600 active:bg-brand-700">Cotizar</a>
      {whatsappNumber && <a href={floatingHref} target="_blank" rel="noopener noreferrer" class="flex h-14 items-center justify-center bg-green-600 active:bg-green-700">WhatsApp</a>}
      <a href={LEGAL.phoneHref} class="flex h-14 items-center justify-center active:bg-white/10">Llamar</a>
    </div>

    <!-- Confirmation shown when something is added to the quote list (also announced to screen readers). -->
    <div id="cart-toast" role="status" aria-live="polite" hidden class="fixed bottom-[4.5rem] left-4 z-50 max-w-[calc(100vw-2rem)] rounded-sm bg-steel-900 px-4 py-3 text-sm text-white shadow-lg print:hidden md:bottom-4 md:max-w-sm">
      <span data-toast-text></span>
      <a href="/cotizacion/" class="ml-2 font-semibold underline">Ver mi cotización</a>
    </div>
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
